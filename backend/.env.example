# Database
DATABASE_URL=postgresql+asyncpg://trainingdash:trainingdash@localhost:5432/trainingdash

# Session secret
SECRET_KEY=dev-secret-change-me

# Encryption key for credentials (generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())")
TRAININGDASH_ENCRYPTION_KEY=

# Redis for arq job queue (optional)
REDIS_URL=redis://localhost:6379

# Xert API credentials for integration tests (optional)
# XERT_TEST_USERNAME=your-email@example.com
# XERT_TEST_PASSWORD=your-password

# OAuth: GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth: Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL for OAuth redirect URIs (no trailing slash)
BASE_URL=http://localhost:8000
