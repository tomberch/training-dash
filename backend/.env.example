# Database
DATABASE_URL=postgresql+asyncpg://fitter:fitter@localhost:5432/fitter

# Session secret
SECRET_KEY=dev-secret-change-me

# Encryption key for Xert credentials (generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())")
FITTER_ENCRYPTION_KEY=

# Redis for arq job queue (optional)
REDIS_URL=redis://localhost:6379

# Xert API credentials for integration tests (optional)
# XERT_TEST_USERNAME=your-email@example.com
# XERT_TEST_PASSWORD=your-password
